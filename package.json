{
  "name": "gh-pr-render",
  "version": "0.6.0",
  "description": "Render GitHub PRs with comments for LLM PR reviews",
  "keywords": [
    "ai",
    "cli",
    "code-review",
    "github",
    "llm",
    "pull-request"
  ],
  "license": "MIT OR Apache-2.0",
  "author": "Daniel Parks <oss-gh-pr-render@demonhorse.org> (https://demon.horse)",
  "bin": {
    "gh-pr-render": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "jiti src/index.ts",
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc -p tsconfig.check.json",
    "lint": "oxlint && rumdl check .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "record": "jiti scripts/record.ts",
    "setup": "jiti scripts/setup.ts",
    "update-readme": "jiti scripts/update-readme.ts"
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.3",
    "commander": "^14.0.3",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "rumdl": "^0.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.18.3"
  },
  "prepare": "tsc"
}
