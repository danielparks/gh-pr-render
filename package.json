{
  "name": "gh-pr-render",
  "version": "0.3.0",
  "description": "Render GitHub PRs with comments for LLM PR reviews",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "prepare": "tsc",
  "bin": {
    "gh-pr-render": "dist/index.js"
  },
  "scripts": {
    "start": "jiti src/index.ts",
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest run",
    "record": "jiti scripts/record.ts",
    "setup": "jiti scripts/setup.ts",
    "update-readme": "jiti scripts/update-readme.ts"
  },
  "keywords": [
    "github",
    "pull-request",
    "llm",
    "ai",
    "code-review",
    "cli"
  ],
  "author": "Daniel Parks <oss-gh-pr-render@demonhorse.org> (https://demon.horse)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.3"
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.3",
    "commander": "^14.0.3",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/css": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.8"
  }
}
